*.py[codz]
*$py.class
*.so

# Environments
.env
.envrc
.venv
env/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.eggs/
.installed.cfg
*.egg

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage/
htmlcov/


