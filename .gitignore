.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
.vite/
.turbo/



# ==========================================
# Project-Specific
# ==========================================
# Ignore all contents of the test config folder...
manifest/config/*
# ...but keep the folder itself in Git so the path structure exists
!manifest/config/.gitkeep
